---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTH_COOKIE, dailyLimit, hasUnlimitedAccess, isConfigured } from '../lib/chat';

export const prerender = false;

const configured = isConfigured();
const unlimited = hasUnlimitedAccess(Astro.cookies.get(AUTH_COOKIE)?.value);
const limit = dailyLimit();
---

<BaseLayout wide title="与 Emilia 对话 · justEMT" description="和栖息在冰上美术馆里的银发半精灵聊聊天。">
  <section data-chat-page class="chat reveal" data-configured={configured ? 'true' : 'false'} data-unlimited={unlimited ? 'true' : 'false'}>
    <header class="chat__intro">
      <div class="min-w-0">
        <p class="eyebrow text-lilac-500 dark:text-lilac-300">TALK WITH EMILIA</p>
        <h1 class="mt-4 font-display text-4xl font-black tracking-wide sm:text-5xl">
          <span class="text-frost">与 Emilia 对话</span>
        </h1>
        <p class="mt-4 max-w-xl text-base leading-8 text-slate-600 dark:text-slate-300">
          雪停下来的时候，她会认真听你说话。对话不会被保存在服务器上。
        </p>
      </div>
      <div class="chat__intro-side">
        <span id="chat-quota" class="chat__chip" role="status">
          <span class="chat__chip-dot" aria-hidden="true"></span>
          {configured ? '正在确认今日次数…' : '服务尚未连接'}
        </span>
        <button id="chat-clear" type="button" class="chat__ghost-button">清空对话</button>
      </div>
    </header>

    {!configured && (
      <p class="chat__notice mt-8 text-sm text-slate-500 dark:text-slate-300">
        对话服务还没有连接。配置 <code>AI_API_KEY</code> 与 <code>AI_BASE_URL</code> 之后，这里就能开始聊天了。
      </p>
    )}

    <div class="chat__shell mt-10">
      <div id="chat-thread" class="chat__thread" aria-live="polite" aria-label="对话记录">
        <div id="chat-empty" class="chat__empty">
          <p class="font-display text-2xl font-bold text-frost">今天想聊些什么呢？</p>
          <p class="mt-3 text-sm leading-7 text-slate-500 dark:text-slate-400">
            随便问都可以。技术问题、心里话，或者只是想有人陪着说说话。
          </p>
          <div class="chat__suggestions">
            <button type="button" class="chat__suggestion" data-prompt="给我讲讲你眼中的雪，好吗？">给我讲讲你眼中的雪</button>
            <button type="button" class="chat__suggestion" data-prompt="帮我用 TypeScript 写一个带超时的 fetch 封装">写一个带超时的 fetch</button>
            <button type="button" class="chat__suggestion" data-prompt="今天有点累，说点让人安心的话吧。">今天有点累</button>
          </div>
        </div>
      </div>

      <form id="chat-form" class="chat__composer">
        <label class="sr-only" for="chat-input">想说的话</label>
        <textarea
          id="chat-input"
          name="message"
          rows="1"
          maxlength="4000"
          placeholder={configured ? '和 Emilia 说点什么…（Enter 发送，Shift + Enter 换行）' : '对话服务尚未开启'}
          disabled={!configured}
          class="chat__input"
        ></textarea>
        <div class="chat__composer-actions">
          <p id="chat-hint" class="chat__hint">
            {unlimited ? '已登录，不限次数。' : `公开对话每天合计 ${limit} 次，登录后不限次。`}
          </p>
          <button id="chat-stop" type="button" class="chat__ghost-button hidden">停止</button>
          <button id="chat-send" type="submit" class="chat__send" disabled={!configured}>
            <span id="chat-send-label">发送</span>
          </button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  type Role = 'user' | 'assistant';
  type Message = { role: Role; content: string };

  /** 只在本地留存对话，服务端不保存任何内容 */
  const STORAGE_KEY = 'justemt:chat:history';
  /** 与服务端 MAX_MESSAGES 对齐：更早的消息不会随请求发出 */
  const MAX_MESSAGES = 21;

  let activeChatPage: HTMLElement | undefined;
  let cleanupChatPage: (() => void) | undefined;

  function initializeChatPage() {
    const page = document.querySelector<HTMLElement>('[data-chat-page]');
    if (!page || page === activeChatPage) return;

    cleanupChatPage?.();
    activeChatPage = page;

    const configured = page.dataset.configured === 'true';
    const unlimited = page.dataset.unlimited === 'true';

    const thread = page.querySelector<HTMLElement>('#chat-thread')!;
    const empty = page.querySelector<HTMLElement>('#chat-empty')!;
    const form = page.querySelector<HTMLFormElement>('#chat-form')!;
    const input = page.querySelector<HTMLTextAreaElement>('#chat-input')!;
    const send = page.querySelector<HTMLButtonElement>('#chat-send')!;
    const sendLabel = page.querySelector<HTMLElement>('#chat-send-label')!;
    const stop = page.querySelector<HTMLButtonElement>('#chat-stop')!;
    const clear = page.querySelector<HTMLButtonElement>('#chat-clear')!;
    const quota = page.querySelector<HTMLElement>('#chat-quota')!;

    const lifecycle = new AbortController();
    /** 当前这轮回答的取消器，和页面生命周期分开 */
    let turn: AbortController | undefined;
    let messages: Message[] = [];

    /* ---------------- 本地历史 ---------------- */

    const isMessage = (value: unknown): value is Message => {
      const item = value as Partial<Message> | null;
      return (item?.role === 'user' || item?.role === 'assistant') && typeof item.content === 'string';
    };

    const load = (): Message[] => {
      try {
        const raw = window.localStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        const parsed: unknown = JSON.parse(raw);
        if (!Array.isArray(parsed)) return [];
        // 历史内容可能被手改过，逐条校验后只留结构合法的
        return parsed.filter(isMessage).map(({ role, content }) => ({ role, content }));
      } catch {
        // localStorage 不可用（隐私模式）或内容损坏时从空对话开始
        return [];
      }
    };

    const save = () => {
      try {
        window.localStorage.setItem(STORAGE_KEY, JSON.stringify(messages.slice(-MAX_MESSAGES * 2)));
      } catch {
        // 存不下就算了，不影响当前这轮对话
      }
    };

    /* ---------------- 渲染 ---------------- */

    const scrollToBottom = () => {
      thread.scrollTop = thread.scrollHeight;
    };

    /**
     * 极轻量的 Markdown 渲染：只处理代码块、行内代码和段落。
     * 全程用 textContent 写入，不拼 innerHTML —— 模型输出等同于不可信内容，
     * 拼 HTML 就等于把 XSS 的入口交给上游。
     */
    const renderMarkdown = (target: HTMLElement, text: string) => {
      target.replaceChildren();

      for (const [index, segment] of text.split(/```/).entries()) {
        // 奇数段落在两个 ``` 之间，按代码块处理
        if (index % 2 === 1) {
          const firstBreak = segment.indexOf('\n');
          const lang = firstBreak > 0 ? segment.slice(0, firstBreak).trim() : '';
          const code = firstBreak >= 0 ? segment.slice(firstBreak + 1) : segment;

          const block = document.createElement('div');
          block.className = 'chat__code';
          if (lang) {
            const label = document.createElement('span');
            label.className = 'chat__code-lang';
            label.textContent = lang;
            block.append(label);
          }
          const pre = document.createElement('pre');
          const codeEl = document.createElement('code');
          codeEl.textContent = code.replace(/\n$/, '');
          pre.append(codeEl);
          block.append(pre);
          target.append(block);
          continue;
        }

        for (const paragraph of segment.split(/\n{2,}/)) {
          if (!paragraph.trim()) continue;
          const p = document.createElement('p');
          // 行内代码同样只用 textContent 填充
          paragraph.split(/(`[^`\n]+`)/).forEach((part, partIndex) => {
            if (!part) return;
            if (partIndex % 2 === 1) {
              const code = document.createElement('code');
              code.textContent = part.slice(1, -1);
              p.append(code);
            } else {
              // 单个换行保留为软换行
              part.split('\n').forEach((line, lineIndex) => {
                if (lineIndex) p.append(document.createElement('br'));
                p.append(document.createTextNode(line));
              });
            }
          });
          target.append(p);
        }
      }
    };

    const createBubble = (role: Role) => {
      const row = document.createElement('article');
      row.className = `chat__row chat__row--${role}`;

      const label = document.createElement('span');
      label.className = 'chat__role';
      label.textContent = role === 'user' ? '你' : 'Emilia';

      const bubble = document.createElement('div');
      bubble.className = 'chat__bubble';

      row.append(label, bubble);
      thread.append(row);
      return bubble;
    };

    const renderAll = () => {
      thread.querySelectorAll('.chat__row').forEach((row) => row.remove());
      // 只有第一次对话时才展示引导语
      empty.classList.toggle('hidden', messages.length > 0);
      for (const message of messages) {
        renderMarkdown(createBubble(message.role), message.content);
      }
      scrollToBottom();
    };

    /* ---------------- 用量 ---------------- */

    const showQuota = (text: string, tone: 'ok' | 'warn' | 'idle' = 'ok') => {
      quota.classList.toggle('is-warn', tone === 'warn');
      quota.classList.toggle('is-idle', tone === 'idle');
      const dot = quota.querySelector('.chat__chip-dot');
      quota.replaceChildren();
      if (dot) quota.append(dot);
      quota.append(document.createTextNode(text));
    };

    async function refreshQuota() {
      if (!configured) {
        showQuota('服务尚未连接', 'idle');
        return;
      }
      if (unlimited) {
        showQuota('已登录 · 不限次数');
        return;
      }
      try {
        const response = await fetch('/api/chat', { cache: 'no-store', signal: lifecycle.signal });
        const body = await response.json() as { ok?: boolean; remaining?: number; limit?: number };
        if (!response.ok || !body.ok) throw new Error('读取失败');
        const remaining = body.remaining ?? 0;
        showQuota(`今日剩余 ${remaining} / ${body.limit ?? 0} 次`, remaining > 0 ? 'ok' : 'warn');
      } catch {
        if (lifecycle.signal.aborted) return;
        showQuota('次数状态未知', 'idle');
      }
    }

    /* ---------------- 发送 ---------------- */

    const setBusy = (busy: boolean) => {
      send.disabled = busy || !configured;
      sendLabel.textContent = busy ? '回答中…' : '发送';
      stop.classList.toggle('hidden', !busy);
      input.disabled = busy || !configured;
    };

    const autoGrow = () => {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 200)}px`;
    };

    async function submit(text: string) {
      if (!configured || turn) return;
      const content = text.trim().slice(0, 4000);
      if (!content) return;

      messages.push({ role: 'user', content });
      save();
      empty.classList.add('hidden');
      renderMarkdown(createBubble('user'), content);

      const bubble = createBubble('assistant');
      bubble.classList.add('is-streaming');
      const cursor = document.createElement('span');
      cursor.className = 'type-caret';
      bubble.append(cursor);
      scrollToBottom();

      turn = new AbortController();
      setBusy(true);
      input.value = '';
      autoGrow();

      let answer = '';
      /** 展示错误时不写入历史，避免把报错当成 Emilia 说过的话带进下一轮 */
      const fail = (message: string) => {
        bubble.classList.remove('is-streaming');
        bubble.classList.add('chat__bubble--error');
        bubble.replaceChildren(Object.assign(document.createElement('p'), { textContent: message }));
      };

      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          // 只发最近若干条，和服务端的裁剪规则保持一致
          body: JSON.stringify({ messages: messages.slice(-MAX_MESSAGES) }),
          signal: turn.signal,
        });

        if (!response.ok || !response.body) {
          const body = await response.json().catch(() => ({})) as { message?: string };
          fail(body.message ?? '这次没能连上，稍后再试试？');
          return;
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        let streamError: string | undefined;

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;

          buffer += decoder.decode(value, { stream: true });
          // SSE 事件以空行分隔；最后一段可能不完整，留着等下一块
          const chunks = buffer.split('\n\n');
          buffer = chunks.pop() ?? '';

          for (const chunk of chunks) {
            const type = chunk.match(/^event:\s*(.+)$/m)?.[1]?.trim();
            const raw = chunk.match(/^data:\s*(.+)$/m)?.[1];
            if (!type || !raw) continue;

            if (type === 'delta') {
              const delta = JSON.parse(raw) as string;
              answer += delta;
              renderMarkdown(bubble, answer);
              bubble.append(cursor);
              scrollToBottom();
            } else if (type === 'error') {
              streamError = (JSON.parse(raw) as { message?: string }).message ?? 'AI 服务暂时不可用';
            }
          }
        }

        if (answer) {
          messages.push({ role: 'assistant', content: answer });
          save();
          bubble.classList.remove('is-streaming');
          renderMarkdown(bubble, answer);
          // 流中报错但已经出了一部分文字：保留内容，另起一行说明中断原因
          if (streamError) {
            const note = document.createElement('p');
            note.className = 'chat__bubble-note';
            note.textContent = `（回答中断：${streamError}）`;
            bubble.append(note);
          }
        } else {
          fail(streamError ?? '这次她没有说话，再问一次看看？');
        }
      } catch (error) {
        if (turn.signal.aborted) {
          bubble.classList.remove('is-streaming');
          cursor.remove();
          // 手动停止时保留已经收到的部分，让它能继续参与上下文
          if (answer) {
            messages.push({ role: 'assistant', content: answer });
            save();
          } else {
            bubble.closest('.chat__row')?.remove();
          }
        } else {
          fail(error instanceof Error && error.message ? '网络中断了，稍后再试试？' : '出了点问题');
        }
      } finally {
        cursor.remove();
        turn = undefined;
        setBusy(false);
        if (!lifecycle.signal.aborted) input.focus();
        void refreshQuota();
      }
    }

    /* ---------------- 事件 ---------------- */

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void submit(input.value);
    }, { signal: lifecycle.signal });

    // Enter 发送、Shift + Enter 换行；输入法组合中的回车不触发发送
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' || event.shiftKey || event.isComposing) return;
      event.preventDefault();
      void submit(input.value);
    }, { signal: lifecycle.signal });

    input.addEventListener('input', autoGrow, { signal: lifecycle.signal });

    stop.addEventListener('click', () => turn?.abort(), { signal: lifecycle.signal });

    clear.addEventListener('click', () => {
      turn?.abort();
      messages = [];
      save();
      renderAll();
      input.focus();
    }, { signal: lifecycle.signal });

    page.querySelectorAll<HTMLButtonElement>('.chat__suggestion').forEach((button) => {
      button.addEventListener('click', () => {
        void submit(button.dataset.prompt ?? button.textContent ?? '');
      }, { signal: lifecycle.signal });
    });

    messages = load();
    renderAll();
    autoGrow();
    void refreshQuota();
    page.classList.add('is-visible');

    cleanupChatPage = () => {
      turn?.abort();
      lifecycle.abort();
      if (activeChatPage === page) activeChatPage = undefined;
    };
    document.addEventListener('astro:before-swap', cleanupChatPage, { once: true });
  }

  initializeChatPage();
  document.addEventListener('astro:page-load', initializeChatPage);
</script>
