---
import BaseLayout from '../layouts/BaseLayout.astro';
import Particles from '../components/Particles.astro';
import { quotes } from '../data/quotes';
---

<BaseLayout immersive>
  <!-- ===== 首屏：雪夜美术馆 ===== -->
  <section class="hero relative z-10 flex h-svh items-center justify-center overflow-hidden">
    <Particles />

    <div class="px-4 text-center">
      <p class="font-display text-sm tracking-[0.5em] text-[#4a4368]/70 dark:text-white/80 sm:text-base">
        エミリアたん、マジ天使
      </p>
      <h1 class="hero-title mt-4 font-display text-7xl font-black tracking-tight sm:text-9xl">
        E·M·T
      </h1>
      <p class="mx-auto mt-6 max-w-md text-base leading-relaxed text-[#3d3658]/85 drop-shadow dark:text-white/80 sm:text-lg">
        <span id="typewriter"></span><span class="type-caret"></span>
      </p>
    </div>

    <a
      href="#content"
      aria-label="向下滚动"
        class="scroll-hint absolute bottom-8 left-1/2 -translate-x-1/2 text-[#4a4368]/70 transition-colors hover:text-[#2e2848] dark:text-white/70 dark:hover:text-white"
    >
      <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
      </svg>
    </a>
  </section>

  <!-- ===== 下方内容 ===== -->
  <div id="content" data-home-page class="relative z-10 mx-auto max-w-4xl px-4 py-24">

    <!-- 引言 -->
    <section class="reveal text-center">
      <h2 class="font-display text-3xl font-bold tracking-wide sm:text-4xl">
        <span class="text-frost">冰上的美术馆</span>
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        这里收藏着关于银发半精灵的一切——
        冰晶、微精灵的光、雪夜里说过的话。
        请放轻脚步，慢慢欣赏。
      </p>
    </section>

    <!-- 名台词轮播 -->
    <section class="reveal mt-24">
      <div class="glass glass--liquid relative overflow-hidden rounded-3xl px-8 py-12 text-center sm:px-16">
        <svg class="mx-auto h-8 w-8 text-lilac-400/60" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M9.5 8C7 8 5 10 5 12.5S7 17 9.5 17c.4 0 .8-.1 1.1-.2C10 18.4 8.6 19.6 7 20.2l.6 1.3c3.4-1 5.9-4.2 5.9-8C13.5 10.4 11.8 8 9.5 8Zm9 0C16 8 14 10 14 12.5S16 17 18.5 17c.4 0 .8-.1 1.1-.2-.6 1.6-2 2.8-3.6 3.4l.6 1.3c3.4-1 5.9-4.2 5.9-8 0-3.1-1.7-5.5-4-5.5Z"/>
        </svg>
        <div id="quote-carousel" class="relative mt-6 min-h-32">
          <button
            id="quote-prev"
            type="button"
            aria-label="上一条台词"
            class="absolute -left-4 top-1/2 z-10 -translate-y-1/2 rounded-full p-2 text-lilac-400/60 transition-colors hover:text-lilac-500 sm:-left-10 dark:text-lilac-300/60 dark:hover:text-lilac-200"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
          </button>
          <button
            id="quote-next"
            type="button"
            aria-label="下一条台词"
            class="absolute -right-4 top-1/2 z-10 -translate-y-1/2 rounded-full p-2 text-lilac-400/60 transition-colors hover:text-lilac-500 sm:-right-10 dark:text-lilac-300/60 dark:hover:text-lilac-200"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
          </button>
          {quotes.map((q, i) => (
            <blockquote class:list={['quote-slide', { 'is-active': i === 0 }]}>
              <p class="font-display text-xl font-bold leading-relaxed text-slate-800 dark:text-slate-100 sm:text-2xl">
                {q.zh}
              </p>
              <p class="mt-3 text-sm text-slate-500 dark:text-slate-300">{q.ja}</p>
              <footer class="mt-4 text-xs tracking-widest text-lilac-500 dark:text-lilac-300">
                —— {q.scene}
              </footer>
            </blockquote>
          ))}
        </div>
        <div class="mt-6 flex justify-center gap-2" id="quote-dots">
          {quotes.map((_, i) => (
            <button
              aria-label={`第 ${i + 1} 条`}
              class:list={[
                'quote-dot h-1.5 rounded-full transition-all duration-300',
                i === 0 ? 'w-6 bg-lilac-400' : 'w-1.5 bg-lilac-400/30',
              ]}
              data-index={i}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- 画廊精选 -->
    <section class="reveal mt-24" id="featured-gallery">
        <div class="flex items-end justify-between">
          <h2 class="font-display text-2xl font-bold tracking-wide sm:text-3xl">
            <span class="text-frost">馆藏精选</span>
          </h2>
          <a href="/gallery" class="text-sm text-lilac-500 transition-colors hover:text-violet-700 dark:text-lilac-300 dark:hover:text-white">
            进入画廊 →
          </a>
        </div>
        <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4" id="featured-gallery-grid"></div>
      </section>

  </div>
</BaseLayout>

<script>
  let activeHomePage: HTMLElement | undefined;
  let cleanupHomePage: (() => void) | undefined;

  function initializeHomePage() {
    const page = document.querySelector<HTMLElement>('[data-home-page]');
    if (!page || page === activeHomePage) return;

    cleanupHomePage?.();
    activeHomePage = page;

    const controller = new AbortController();
    const { signal } = controller;
    const lines = [
      '我的名字是 Emilia，只是 Emilia。',
      'わたしの名前はエミリア。ただのエミリアよ。',
    ];
    const tw = document.getElementById('typewriter');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let typewriterTimer: number | undefined;
    let carouselTimer: number | undefined;

    // ---------- 打字机 ----------
    if (tw) {
      if (reduceMotion.matches) {
        tw.textContent = lines[0];
      } else {
        let li = 0;
        let ci = 0;
        let deleting = false;
        const tick = () => {
          const line = lines[li];
          if (!deleting) {
            tw.textContent = line.slice(0, ++ci);
            if (ci === line.length) {
              deleting = true;
              typewriterTimer = window.setTimeout(tick, 2600);
              return;
            }
            typewriterTimer = window.setTimeout(tick, 90);
          } else {
            tw.textContent = line.slice(0, --ci);
            if (ci === 0) {
              deleting = false;
              li = (li + 1) % lines.length;
              typewriterTimer = window.setTimeout(tick, 500);
              return;
            }
            typewriterTimer = window.setTimeout(tick, 35);
          }
        };
        tick();
      }
    }

    // ---------- 名台词轮播 ----------
    const slides = page.querySelectorAll<HTMLElement>('.quote-slide');
    const dots = page.querySelectorAll<HTMLButtonElement>('.quote-dot');
    const stopCarousel = () => {
      if (carouselTimer) clearInterval(carouselTimer);
      carouselTimer = undefined;
    };
    if (slides.length > 1) {
      let current = 0;
      const activate = (index: number) => {
        slides[current].classList.remove('is-active');
        dots[current]?.classList.remove('w-6', 'bg-lilac-400');
        dots[current]?.classList.add('w-1.5', 'bg-lilac-400/30');
        current = index;
        slides[current].classList.add('is-active');
        dots[current]?.classList.add('w-6', 'bg-lilac-400');
        dots[current]?.classList.remove('w-1.5', 'bg-lilac-400/30');
      };
      const startCarousel = () => {
        stopCarousel();
        if (!reduceMotion.matches) {
          carouselTimer = window.setInterval(() => activate((current + 1) % slides.length), 5000);
        }
      };
      dots.forEach((dot, index) =>
        dot.addEventListener('click', () => { activate(index); startCarousel(); }, { signal })
      );
      page.querySelector('#quote-prev')?.addEventListener('click', () => {
        activate((current - 1 + slides.length) % slides.length);
        startCarousel();
      }, { signal });
      page.querySelector('#quote-next')?.addEventListener('click', () => {
        activate((current + 1) % slides.length);
        startCarousel();
      }, { signal });
      document.addEventListener('visibilitychange', () => (
        document.hidden ? stopCarousel() : startCarousel()
      ), { signal });
      startCarousel();
    }

    // ---------- 滚动淡入 ----------
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 },
    );
    page.querySelectorAll('.reveal').forEach((item) => observer.observe(item));

    cleanupHomePage = () => {
      controller.abort();
      observer.disconnect();
      stopCarousel();
      if (typewriterTimer) clearTimeout(typewriterTimer);
      if (activeHomePage === page) activeHomePage = undefined;
    };
    document.addEventListener('astro:before-swap', cleanupHomePage, { once: true });
  }

  initializeHomePage();
  document.addEventListener('astro:page-load', initializeHomePage);
</script>

<script>
  type FeaturedPhoto = { title: string; image: string; thumbnail: string; width: number; height: number };

  let activeFeaturedGrid: HTMLElement | undefined;
  let abortFeaturedRequest: (() => void) | undefined;

  function initializeFeaturedGallery() {
    const featuredGrid = document.getElementById('featured-gallery-grid');
    if (!featuredGrid || featuredGrid === activeFeaturedGrid) return;

    abortFeaturedRequest?.();
    activeFeaturedGrid = featuredGrid;
    const controller = new AbortController();

    fetch('/api/gallery?limit=4&tag=*', { signal: controller.signal })
      .then((response) => response.json() as Promise<{ items?: FeaturedPhoto[] }>)
      .then((body) => {
        if (controller.signal.aborted) return;
        for (const item of body.items ?? []) {
          const link = document.createElement('a');
          link.href = '/gallery';
          link.className = 'gallery-item group relative block overflow-hidden rounded-2xl';
          const image = document.createElement('img');
          image.src = item.thumbnail || item.image;
          image.alt = item.title;
          image.loading = 'lazy';
          if (item.width > 0 && item.height > 0) {
            image.width = item.width;
            image.height = item.height;
          }
          image.className = 'aspect-[3/4] w-full object-cover';
          const label = document.createElement('span');
          label.className = 'pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-3 pt-8 opacity-0 transition-opacity duration-300 group-hover:opacity-100';
          const title = document.createElement('span');
          title.className = 'font-display text-sm font-bold text-white';
          title.textContent = item.title;
          label.append(title);
          link.append(image, label);
          featuredGrid.append(link);
        }
        if (!featuredGrid.children.length) featuredGrid.closest('section')?.remove();
      })
      .catch(() => {
        if (!controller.signal.aborted) featuredGrid.closest('section')?.remove();
      });

    const cleanup = () => {
      controller.abort();
      if (activeFeaturedGrid === featuredGrid) activeFeaturedGrid = undefined;
    };
    abortFeaturedRequest = cleanup;
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }

  initializeFeaturedGallery();
  document.addEventListener('astro:page-load', initializeFeaturedGallery);
</script>
