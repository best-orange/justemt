---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SpiritSparks from '../components/SpiritSparks.astro';
import MusicPlayer from '../components/MusicPlayer.astro';

interface Props {
  title?: string;
  description?: string;
  /** 沉浸式模式：导航透明悬浮、内容全宽（用于首页壁纸首屏） */
  immersive?: boolean;
  /** 宽版内容：用于需要同时展示封面与歌单的工具页面 */
  wide?: boolean;
}

const {
  title = 'justEMT · 爱蜜莉雅主题站',
  description = 'EMT —— 爱蜜莉雅碳真是天使。一座冰上的美术馆，献给银发半精灵。',
  immersive = false,
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />

    <!-- 衬线标题字体；国内网络加载失败时自动回落本地宋体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;700;900&display=swap"
    />

    <!-- 在页面渲染前设定主题，避免刷新时闪烁；默认雪夜（暗色）模式 -->
    <meta name="theme-color" content="#0a0f26" />
    <script is:inline>
      (function () {
        const syncTheme = (targetDocument) => {
          const stored = localStorage.getItem('theme');
          const dark = stored === 'dark' || !stored;
          targetDocument.documentElement.classList.toggle('dark', dark);
          // 同步移动端浏览器地址栏配色
          targetDocument
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', dark ? '#0a0f26' : '#f7f6fd');
        };

        syncTheme(document);

        // Astro 客户端导航会用新页面的 <html> 属性覆盖当前根元素。
        // 在替换前同步主题，避免新页面丢失 dark 类而重置为浅色。
        document.addEventListener('astro:before-swap', (event) => {
          const newDocument = Reflect.get(event, 'newDocument');
          if (newDocument instanceof Document) syncTheme(newDocument);
        });
      })();
    </script>
  </head>
  <body class="min-h-screen font-sans text-slate-800 antialiased dark:text-slate-200">
    <Nav immersive={immersive} />
    {immersive ? (
      <main>
        <slot />
      </main>
    ) : (
      <main class:list={['mx-auto px-4 pb-12 pt-24', wide ? 'max-w-6xl' : 'max-w-3xl']}>
        <slot />
      </main>
    )}
    <Footer />
    <SpiritSparks />
    <MusicPlayer />
  </body>
</html>
