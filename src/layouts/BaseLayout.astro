---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SpiritSparks from '../components/SpiritSparks.astro';
import MusicPlayer from '../components/MusicPlayer.astro';

interface Props {
  title?: string;
  description?: string;
  /** 沉浸式模式：导航透明悬浮、内容全宽（用于首页和登录页等全屏场景） */
  immersive?: boolean;
  /** 宽版内容：用于需要同时展示封面与歌单的工具页面 */
  wide?: boolean;
}

const {
  title = 'justEMT · 爱蜜莉雅主题站',
  description = 'EMT —— 爱蜜莉雅碳真是天使。一座冰上的美术馆，献给银发半精灵。',
  immersive = false,
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />

    <!-- 衬线标题字体；国内网络加载失败时自动回落本地宋体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;700;900&display=swap"
    />

    <!-- 在页面渲染前设定主题，避免刷新时闪烁；默认雪夜（暗色）模式 -->
    <meta name="theme-color" content="#0a0f26" />
    <script is:inline>
      (function () {
        const syncTheme = (targetDocument) => {
          const stored = localStorage.getItem('theme');
          const dark = stored === 'dark' || !stored;
          targetDocument.documentElement.classList.toggle('dark', dark);
          // 同步移动端浏览器地址栏配色
          targetDocument
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', dark ? '#0a0f26' : '#f7f6fd');
        };

        syncTheme(document);

        // Astro 客户端导航会用新页面的 <html> 属性覆盖当前根元素。
        // 在替换前同步主题，避免新页面丢失 dark 类而重置为浅色。
        document.addEventListener('astro:before-swap', (event) => {
          const newDocument = Reflect.get(event, 'newDocument');
          if (newDocument instanceof Document) syncTheme(newDocument);
        });
      })();
    </script>
  </head>
  <body
    class:list={[
      'min-h-screen font-sans text-slate-800 antialiased dark:text-slate-200',
      'site-shell',
      immersive && 'is-immersive',
    ]}
  >
    <Nav immersive={immersive} />
    <!-- 首页壁纸作为全站固定背景；内容通过下方的玻璃层与它融合。 -->
    <div class="site-wallpaper" data-site-wallpaper aria-hidden="true">
      <div class="hero-bg site-wallpaper__image"></div>
      <div class="site-wallpaper__glass"></div>
    </div>

    {immersive ? (
      <main class="site-main site-main--immersive">
        <slot />
      </main>
    ) : (
      <main class:list={['site-main mx-auto px-4 pb-12 pt-24', wide ? 'max-w-6xl' : 'max-w-3xl']}>
        <div class="site-content-surface">
          <slot />
        </div>
      </main>
    )}
    <!-- 页面级浮层必须脱离内容玻璃面板，否则 fixed 会被面板的层叠上下文和 overflow 影响。 -->
    <slot name="overlay" />
    <Footer />
    <SpiritSparks />
    <MusicPlayer />
  </body>
</html>

<script is:inline>
  (() => {
    let cleanup = () => {};
    let glassFrame;

    const initializeSiteWallpaper = () => {
      cleanup();

      const wallpaper = document.querySelector('[data-site-wallpaper]');
      if (!wallpaper) return;

      const controller = new AbortController();
      const updateGlass = () => {
        glassFrame = undefined;

        const scrollRange = Math.max(window.innerHeight * 1.25, 1);
        const rawProgress = Math.min(Math.max(window.scrollY / scrollRange, 0), 1);
        // 让玻璃层在刚开始上滑时更柔和，接近内容区时再明显出现。
        const progress = rawProgress * rawProgress * (3 - 2 * rawProgress);

        wallpaper.style.setProperty('--site-glass-opacity', (0.035 + progress * 0.66).toFixed(3));
        wallpaper.style.setProperty('--site-glass-blur', `${(progress * 22).toFixed(2)}px`);
        wallpaper.style.setProperty('--site-glass-saturation', (1 + progress * 0.38).toFixed(3));
      };
      const requestGlassUpdate = () => {
        if (glassFrame === undefined) glassFrame = window.requestAnimationFrame(updateGlass);
      };

      updateGlass();
      window.addEventListener('scroll', requestGlassUpdate, { passive: true, signal: controller.signal });
      window.addEventListener('resize', requestGlassUpdate, { passive: true, signal: controller.signal });

      cleanup = () => {
        controller.abort();
        if (glassFrame !== undefined) window.cancelAnimationFrame(glassFrame);
        glassFrame = undefined;
      };
    };

    initializeSiteWallpaper();
    document.addEventListener('astro:page-load', initializeSiteWallpaper);
    document.addEventListener('astro:before-swap', cleanup);
  })();
</script>

<!-- 静态页面也需要记录来访；通过接口写入共享存储，站内切换时由 page-load 事件补记。 -->
<script is:inline>
  (() => {
    const marker = '__justEmtVisitorTracking';
    if (Reflect.get(globalThis, marker)) return;
    Reflect.set(globalThis, marker, true);

    const isTrackablePath = (path) => path.startsWith('/')
      && !path.startsWith('/api/')
      && !path.startsWith('/_astro/')
      && path !== '/login'
      && path !== '/visitors'
      && path !== '/gallery/manage'
      && !path.startsWith('/blog/');

    const recordCurrentPage = () => {
      const path = window.location.pathname;
      if (!isTrackablePath(path)) return;
      void fetch('/api/visitors', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path }),
        keepalive: true,
      }).catch(() => {
        // 统计故障不能影响页面使用。
      });
    };

    document.addEventListener('astro:page-load', recordCurrentPage);
    // 正常情况下由 astro:page-load 覆盖首屏；若脚本在事件之后才执行，再补一次。
    if (document.readyState === 'complete') recordCurrentPage();
  })();
</script>
