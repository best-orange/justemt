# 复制为 .env 后填入真实值（.env 已被 gitignore）
# 部署时在 Vercel 项目的 Settings → Environment Variables 里配同名变量

# 博客访问密码与会话签名密钥
BLOG_PASSWORD=
AUTH_SECRET=

# 对话登录暗号（可选）：设置后 /chat 的「登录后不限次」改用这个独立暗号
# 博客登录不再解锁对话；留空则沿用 BLOG_PASSWORD
CHAT_PASSWORD=

# 网站上线时间（ISO 8601）；不填则按项目默认上线时间计算运行时长
SITE_LAUNCHED_AT=2026-08-19T21:24:14+08:00

# 音乐播放器：https://api.chksz.com/ 注册后在「查看密钥」获取
# 两个都留空时，播放器组件不会渲染
MUSIC_API_KEY=
# 网易云歌单 ID，即歌单链接 ?id= 后面那串数字
MUSIC_PLAYLIST_ID=708672570
# 音质，可选 standard/exhigh/lossless/hires/jymaster 等，默认 exhigh(320k)
# 母带音质单曲上百 MB，移动端慎用
MUSIC_LEVEL=exhigh
# 每日调用上游的次数上限，默认 390。留空即用默认值
MUSIC_DAILY_LIMIT=390
# 歌单缓存秒数，默认 3600
MUSIC_PLAYLIST_TTL=3600
# 单曲地址缓存秒数，默认 14400(4 小时)。设长省配额，代价是偶尔缓存到失效地址
# （前端播放报错时会自动清缓存重取，所以偏向设长）
MUSIC_SONG_TTL=14400

# 共享存储：生产环境强烈建议配置。
# 用于跨 Vercel 实例的配额、缓存、访客统计和 burst rate limit。
# Vercel/Upstash 集成会自动注入这两个变量；不配则本地/开发回落到进程内存。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 自建反向代理时可指定“由代理覆盖、客户端不能伪造”的真实 IP 请求头，
# 例如 Cloudflare Tunnel/Proxy 可按部署拓扑考虑 cf-connecting-ip。
# Vercel 部署通常留空，代码会使用平台覆写的 x-real-ip / x-forwarded-for。
TRUSTED_IP_HEADER=

# AI 对话（可选）：留空 AI_API_KEY 时 /chat 只显示「服务尚未连接」，不发请求
# 只要求上游兼容 /chat/completions 的流式协议，OpenAI/DeepSeek/Moonshot/OpenRouter 都可用
AI_API_KEY=
# 上游根地址，需带版本前缀，默认 https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1
# 默认 gpt-4o-mini
AI_MODEL=gpt-4o-mini
# 人物设定，留空用内置的爱蜜莉雅设定
AI_SYSTEM_PROMPT=
# 未登录访客每天「全站合计」次数（不是每人），默认 30，硬顶 100
# 非法值或 0 会回落到默认值。登录后不计日配额，但仍有短时 burst limit
AI_DAILY_LIMIT=30

# 画廊图床（Cloudflare R2，可选）
# 不配置时画廊继续读取 src/content/gallery/*.yaml
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2 桶的公开访问根地址，例如 https://img.example.com
R2_PUBLIC_URL=
