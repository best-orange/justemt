---
/**
 * 飘雪与微精灵光点粒子层。
 * 用法：放在 position:relative 的容器内（通常是首屏 Hero）。
 * - 尊重 prefers-reduced-motion：静态渲染一帧后不启动动画
 * - 滚出视野 / 标签页隐藏时自动暂停
 */
interface Props {
  /** 雪花密度系数（相对画布面积），默认 1 */
  density?: number;
}

const { density = 1 } = Astro.props;
---

<canvas
  class="particles pointer-events-none absolute inset-0 -z-[5] h-full w-full"
  data-density={density}
  aria-hidden="true"></canvas>

<script>
  type Flake = {
    x: number; y: number; r: number;
    vy: number; sway: number; phase: number; alpha: number;
  };
  type Wisp = {
    x: number; y: number; r: number;
    vy: number; vx: number; alpha: number; pulse: number; hue: number;
  };

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.particles');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const density = Number(canvas.dataset.density || 1);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let flakes: Flake[] = [];
    let wisps: Wisp[] = [];
    let width = 0;
    let height = 0;
    let raf = 0;
    let running = false;

    const rand = (min: number, max: number) => min + Math.random() * (max - min);

    function resize() {
      if (!canvas || !ctx) return;
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const area = (width * height) / (1280 * 720);
      const flakeCount = Math.round(90 * area * density);
      const wispCount = Math.round(14 * area * density);

      flakes = Array.from({ length: flakeCount }, () => ({
        x: rand(0, width),
        y: rand(0, height),
        r: rand(0.6, 2.2),
        vy: rand(0.25, 0.9),
        sway: rand(0.3, 1.2),
        phase: rand(0, Math.PI * 2),
        alpha: rand(0.25, 0.85),
      }));

      wisps = Array.from({ length: wispCount }, () => ({
        x: rand(0, width),
        y: rand(0, height),
        r: rand(1.6, 3.6),
        vy: rand(-0.22, -0.08), // 微精灵缓缓上浮
        vx: rand(-0.08, 0.08),
        alpha: rand(0.3, 0.7),
        pulse: rand(0, Math.PI * 2),
        hue: Math.random() < 0.5 ? 258 : 200, // 薰衣草紫 / 冰蓝
      }));
    }

    let t = 0;
    function frame() {
      if (!ctx) return;
      t += 0.016;
      ctx.clearRect(0, 0, width, height);

      // 雪花：下落 + 左右轻摆
      for (const f of flakes) {
        f.y += f.vy;
        f.phase += 0.01;
        const x = f.x + Math.sin(f.phase) * f.sway * 8;
        if (f.y > height + 4) {
          f.y = -4;
          f.x = rand(0, width);
        }
        ctx.beginPath();
        ctx.arc(x, f.y, f.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,255,255,${f.alpha})`;
        ctx.fill();
      }

      // 微精灵：发光圆点，缓慢上浮，呼吸式明暗
      for (const w of wisps) {
        w.y += w.vy;
        w.x += w.vx + Math.sin(t + w.pulse) * 0.1;
        if (w.y < -8) {
          w.y = height + 8;
          w.x = rand(0, width);
        }
        const glow = w.alpha * (0.65 + 0.35 * Math.sin(t * 1.6 + w.pulse));
        const grad = ctx.createRadialGradient(w.x, w.y, 0, w.x, w.y, w.r * 4);
        grad.addColorStop(0, `hsla(${w.hue}, 90%, 82%, ${glow})`);
        grad.addColorStop(1, `hsla(${w.hue}, 90%, 82%, 0)`);
        ctx.beginPath();
        ctx.arc(w.x, w.y, w.r * 4, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
      }
    }

    function loop() {
      frame();
      if (running) raf = requestAnimationFrame(loop);
    }

    function start() {
      if (running || reduceMotion.matches || !ctx) return;
      running = true;
      raf = requestAnimationFrame(loop);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    resize();
    window.addEventListener('resize', resize);

    if (reduceMotion.matches) {
      frame(); // 静态一帧，作为氛围点缀
    } else {
      // 滚出视野时暂停
      new IntersectionObserver(
        ([entry]) => (entry.isIntersecting ? start() : stop()),
        { threshold: 0 }
      ).observe(canvas);
      document.addEventListener('visibilitychange', () =>
        document.hidden ? stop() : start()
      );
    }
  }
</script>
