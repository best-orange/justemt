---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { AUTH_COOKIE, verifyToken } from '../../lib/auth';

export const prerender = false;

const posts = await getCollection('blog', ({ data }) => !data.draft);
const post = posts.find((item) => item.id === Astro.params.slug);

if (!post) {
  return Astro.redirect('/blog', 302);
}

if (post.data.private && !verifyToken(Astro.cookies.get(AUTH_COOKIE)?.value)) {
  return Astro.redirect(`/login?next=${encodeURIComponent(`/blog/${post.id}`)}`, 302);
}

const { Content } = await render(post);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  isPrivate={post.data.private}
>
  <Content />
</BlogPost>
